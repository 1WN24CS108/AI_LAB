
def unify(x, y, subs):
    if x == y:
        return subs

    if isinstance(x, str) and x.islower():
        if x in y:
            return None
        subs[x] = y
        return subs

    if isinstance(y, str) and y.islower():
        if y in x:
            return None
        subs[y] = x
        return subs

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x) != len(y):
            return None

        for a, b in zip(x[1:], y[1:]):
            for key in subs:
                a = str(a).replace(key, subs[key])
                b = str(b).replace(key, subs[key])

            subs = unify(a, b, subs)

            if subs is None:
                return None

        return subs

    return None


e1 = ("Eats", "x", "Apple")
e2 = ("Eats", "Riya", "y")

result = unify(e1, e2, {})

if result is None:
    print("Unification Failed")
else:
    print("Unification Successful")
    print("Substitution:", result)
